@page "/"
@using CaRP.Shared.Dtos
@rendermode InteractiveWebAssembly
@inject IJSRuntime JSRuntime
@inject HttpClient Http
@inject NavigationManager Nav

<PageTitle>Witaj w CaRP</PageTitle>

<div class="container text-center mt-5">
    <h1 class="display-3 fw-bold text-primary mb-2">Witaj w CaRP!</h1>
    <p class="lead text-muted mb-5">System zarządzania twoją flotą pojazdów</p>

    @* TODO: logo image in here
    
    <div class="logo-container my-5 py-4">
        <div class="mx-auto shadow-sm d-flex align-items-center justify-content-center" 
             style="width: 250px; height: 250px; background-color: #f8f9fa; border-radius: 50%; border: 2px dashed #dee2e6;">
            <i class="bi bi-car-front text-secondary" style="font-size: 100px;"></i>
            </div>
    </div>
    *@

    @if (isLoading)
    {
        <div class="text-center p-4">
            <img src="fish_carp.png" alt="Wczytywanie..." class="spinner-border border-0" style="width: 80px; height: 80px;" />
        </div>
    }
    else if (isLoggedIn)
    {
        <div class="d-grid gap-3 mt-5">
            <a href="/home" class="btn btn-primary btn-lg px-5 shadow">
                <i class="bi bi-house-door me-2"></i> Przejdź do panelu użytkownika
            </a>
            <button class="btn btn-outline-danger btn-lg px-4" @onclick="HandleLogout">
                <i class="bi bi-box-arrow-right me-2"></i> Wyloguj się
            </button>
        </div>
    }
    else 
    {
        <div class="d-flex flex-column align-items-center gap-3 mt-4">
            <button class="btn btn-primary btn-lg px-5 shadow" @onclick="HandleLogin">
                <i class="bi bi-box-arrow-in-right me-2"></i> Zaloguj się
            </button>
            <button class="btn btn-outline-primary btn-lg px-5" @onclick="HandleSignUp">
                <i class="bi bi-person-plus me-2"></i> Zarejestruj się
            </button>
        </div>
    }
</div>

@using CaRP.Shared.Dtos
@implements IDisposable

@code {
    private bool isLoading = true;
    private bool isLoggedIn = false;
    private bool isCheckingModal = false;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                await JSRuntime.InvokeVoidAsync("clerkInterop.init");
                await CheckAuthState();
            }
            catch (Exception ex)
            {
                Console.WriteLine($"Error during initialization: {ex.Message}");
            }
            finally
            {
                isLoading = false;
                StateHasChanged();
            }
        }
    }

    private async Task CheckAuthState()
    {
        try
        {
            // Direct boolean check from our new JS method
            isLoggedIn = await JSRuntime.InvokeAsync<bool>("clerkInterop.hasActiveSession");
        }
        catch
        {
            isLoggedIn = false;
        }
    }

    private async Task HandleLogin()
    {
        await JSRuntime.InvokeVoidAsync("clerkInterop.openSignIn");
        StartAuthCheckLoop();
    }

    private async Task HandleSignUp()
    {
        await JSRuntime.InvokeVoidAsync("clerkInterop.openSignUp");
        StartAuthCheckLoop();
    }

    // This background loop watches for the modal completion
    private async void StartAuthCheckLoop()
    {
        if (isCheckingModal) return;
        isCheckingModal = true;

        // Check for a session every 1 second, up to 60 times (1 minute timeout)
        for (int i = 0; i < 60; i++)
        {
            await Task.Delay(1000);

            await CheckAuthState();

            if (isLoggedIn)
            {
                // User logged in successfully! Update UI and break loop.
                StateHasChanged();
                break;
            }
        }

        isCheckingModal = false;
    }

    private async Task HandleLogout()
    {
        try
        {
            await JSRuntime.InvokeVoidAsync("clerkInterop.logout");
            isLoggedIn = false;
            StateHasChanged();
            Nav.NavigateTo("/", forceLoad: true);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error while logging out: {ex.Message}");
        }
    }

    public void Dispose()
    {
        // Left intentionally blank for now
    }
}