@typeparam TItem
@using CaRP.Client.Components

@if (NewItem != null)
{
    <div class="text-center mb-4">
        <button class="btn btn-success btn-lg px-5 shadow-sm" @onclick="() => showAddModal = true">
            <i class="bi bi-plus-circle me-2"></i> @FormTitle
        </button>
    </div>

    <AddModal IsVisible="showAddModal" Title="@FormTitle" OnClose="() => showAddModal = false">
        <EditForm Model="NewItem" OnValidSubmit="HandleSave">
            <div class="row g-3">
                @FormFields
                
                <div class="col-12 text-end mt-4 pt-3 border-top">
                    <button type="button" class="btn btn-secondary me-2" @onclick="() => showAddModal = false">
                        Anuluj
                    </button>
                    <button type="submit" class="btn btn-success">
                        <i class="bi bi-check-circle"></i> @ButtonLabel
                    </button>
                </div>
            </div>
        </EditForm>
    </AddModal>
}

@if (Items == null)
{
    <div class="text-center p-4">
        <img src="fish_carp.png" alt="Wczytywanie..." class="spinner-border border-0" style="width: 80px; height: 80px;" />
        <p class="mt-3 text-muted">Pobieranie...</p>
    </div>
}
else
{
    <table class="table table-striped table-hover">
        <thead class="table-dark">
        <tr>
            <!-- <th> -->
            @TableHeader
            <th>Akcje</th>
        </tr>
        </thead>
        <tbody>
        @if (Items != null)
        {
            @foreach (var item in Items)
            {
                <tr>
                    @TableRow(item)
                    <td>
                        <button class="btn btn-sm btn-info text-white" @onclick="() => OnDetails.InvokeAsync(item)">Szczegóły</button>
                        <button class="btn btn-sm btn-primary" @onclick="() => OnEdit.InvokeAsync(item)">Edytuj</button>
                        <button class="btn btn-sm btn-danger" @onclick="() => StartDelete(item)">Usuń</button>
                    </td>
                </tr>
            }
        }
        </tbody>
    </table>
}


<ConfirmationModal IsVisible="showModal" 
                   Title="Usuwanie elementu" 
                   Message="Czy na pewno chcesz trwale usunąć ten rekord?"
                   OnConfirm="ConfirmDelete" 
                   OnCancel="() => showModal = false" />


@code {
    [Parameter] public TItem? NewItem { get; set; }
    [Parameter] public string FormTitle { get; set; } = "Dodaj nowy";
    [Parameter] public string ButtonLabel { get; set; } = "Zapisz";
    [Parameter] public Func<Task<bool>> OnSave { get; set; } = default!;
    [Parameter] public RenderFragment? FormFields { get; set; }

    [Parameter] public IEnumerable<TItem>? Items { get; set; }
    [Parameter] public RenderFragment? TableHeader { get; set; }
    [Parameter] public RenderFragment<TItem>? TableRow { get; set; }
    
    [Parameter] public EventCallback<TItem> OnDetails { get; set; }
    [Parameter] public EventCallback<TItem> OnDelete { get; set; }
    [Parameter] public EventCallback<TItem> OnEdit { get; set; }
    
    private bool showModal = false;
    private bool showAddModal = false;
    private TItem? itemToDelete;

    private async Task HandleSave()
    {
        if (OnSave != null)
        {
            bool isSuccess = await OnSave.Invoke();
            if (isSuccess)
            {
                showAddModal = false;
            }
        }
    }
    
    private void StartDelete(TItem item)
    {
        itemToDelete = item;
        showModal = true;
    }

    private async Task ConfirmDelete()
    {
        showModal = false;
        if (itemToDelete != null)
        {
            await OnDelete.InvokeAsync(itemToDelete);
        }
    }
}