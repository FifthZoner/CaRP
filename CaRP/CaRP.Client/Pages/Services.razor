@page "/services"
@using CaRP.Shared.Dtos
@using CaRP.Client.Components
@using carp.Shared.Utils
@inject HttpClient Http
@inject NavigationManager Nav
@rendermode @(new InteractiveWebAssemblyRenderMode(prerender: false))

<PageTitle>Serwisy Pojazdów</PageTitle>

<h1 class="text-center mb-4">Serwisowanie i Naprawy</h1>

<PageTemplate TItem="ServicingDto" 
              Items="servicings" 
              NewItem="newServicing"
              OnSave="AddServicing"
              OnDelete="DeleteServicing"
              OnDetails="ShowDetails"
              OnEdit="OpenEditModal"
              FormTitle="Dodaj nowy wpis serwisowy"
              ButtonLabel="Zapisz serwis"
              Context="service">

    <FormFields>
        @if (!string.IsNullOrEmpty(addErrorMessage))
        {
            <div class="col-12 mb-3">
                <div class="alert alert-danger">
                    <i class="bi bi-exclamation-triangle-fill me-2"></i> @addErrorMessage
                </div>
            </div>
        }

        <div class="col-md-3">
            <label class="form-label font-weight-bold">@Names.GetName((ServicingDto x) => x.ServiceNumber)</label> 
            <InputText class="form-control" @bind-Value="newServicing.ServiceNumber" />
        </div>
        <div class="col-md-3">
            <label class="form-label font-weight-bold">@Names.GetName((ServicingDto x) => x.VehicleId)</label>
            <InputSelect class="form-select" @bind-Value="newServicing.VehicleId">
                <option value="0" disabled>-- Wybierz pojazd --</option>
                @if (availableVehicles != null)
                {
                    @foreach (var v in availableVehicles)
                    {
                        <option value="@v.Id">@v.RegistrationNumber</option>
                    }
                }
            </InputSelect>
        </div>
        <div class="col-md-3">
            <label class="form-label font-weight-bold">@Names.GetName((ServicingDto x) => x.ClerkUsername)</label> 
            <InputText class="form-control" @bind-Value="newServicing.ClerkUsername" disabled />
        </div>
        <div class="col-md-3">
            <label class="form-label font-weight-bold">@Names.GetName((ServicingDto x) => x.ServiceDate)</label>
            <InputDate class="form-control" @bind-Value="newServicing.ServiceDate" />
        </div>
        <div class="col-md-6">
            <label class="form-label font-weight-bold">@Names.GetName((ServicingDto x) => x.MechanicName)</label>
            <InputText class="form-control" @bind-Value="newServicing.MechanicName" />
        </div>
        <div class="col-md-6">
            <label class="form-label font-weight-bold">@Names.GetName((ServicingDto x) => x.Cost)</label>
            <InputNumber class="form-control" @bind-Value="newServicing.Cost" />
        </div>
        <div class="col-md-12">
            <label class="form-label font-weight-bold">@Names.GetName((ServicingDto x) => x.IssueDescription)</label>
            <InputTextArea class="form-control" @bind-Value="newServicing.IssueDescription" rows="3" />
        </div>
    </FormFields>

    <TableHeader>
        <th>@Names.GetName((ServicingDto x) => x.ServiceNumber)</th>
        <th>@Names.GetName((ServicingDto x) => x.VehicleId)</th>
        <th>@Names.GetName((ServicingDto x) => x.ServiceDate)</th>
        <th>@Names.GetName((ServicingDto x) => x.MechanicName)</th>
        <th>@Names.GetName((ServicingDto x) => x.Cost)</th>
    </TableHeader>

    <TableRow>
        <td><strong>@service.ServiceNumber</strong></td>
        <td>@service.VehicleId</td>
        <td>@service.ServiceDate.ToString("dd.MM.yyyy")</td>
        <td>@service.MechanicName</td>
        <td>@service.Cost.ToString("N2") PLN</td>
    </TableRow>

</PageTemplate>

<DetailsModal IsVisible="@showDetailsModal" Title="Szczegóły Serwisu" OnClose="() => showDetailsModal = false">
    @if (selectedServicing == null)
    {
        <div class="text-center">
            <div class="spinner-border text-info" role="status"></div>
            <p>Pobieranie danych...</p>
        </div>
    }
    else
    {
        <div class="row">
            <div class="col-md-6">
                <p><strong>@Names.GetName((ServicingDto x) => x.Id):</strong> @selectedServicing.Id</p>
                <p><strong>@Names.GetName((ServicingDto x) => x.ServiceNumber):</strong> @selectedServicing.ServiceNumber</p>
                <p><strong>@Names.GetName((ServicingDto x) => x.VehicleId):</strong> @selectedServicing.VehicleId</p>
                <p><strong>@Names.GetName((ServicingDto x) => x.ClerkUsername):</strong> @selectedServicing.ClerkUsername</p>
            </div>
            <div class="col-md-6">
                <p><strong>@Names.GetName((ServicingDto x) => x.ServiceDate):</strong> @selectedServicing.ServiceDate.ToString("dd.MM.yyyy")</p>
                <p><strong>@Names.GetName((ServicingDto x) => x.MechanicName):</strong> @selectedServicing.MechanicName</p>
                <div class="alert alert-danger p-2 mt-2">
                    <strong>@Names.GetName((ServicingDto x) => x.Cost):</strong> @selectedServicing.Cost.ToString("N2") PLN
                </div>
            </div>
            <div class="col-12 mt-3">
                <div class="card bg-light border-danger">
                    <div class="card-body">
                        <h6 class="card-subtitle mb-2 text-muted">@Names.GetName((ServicingDto x) => x.IssueDescription):</h6>
                        <p class="card-text">@selectedServicing.IssueDescription</p>
                    </div>
                </div>
            </div>
        </div>
    }
</DetailsModal>


<EditModal IsVisible="@showEditModal" Title="@($"Edycja wpisu serwisowego: {editingServicing.ServiceNumber}")" OnClose="() => showEditModal = false">
    <EditForm Model="editingServicing" OnValidSubmit="SaveEdit">
        
        @if (!string.IsNullOrEmpty(editErrorMessage))
        {
            <div class="alert alert-danger mb-3">
                <i class="bi bi-exclamation-triangle-fill me-2"></i> @editErrorMessage
            </div>
        }

        <div class="row g-3">
            <div class="col-12 bg-light p-3 rounded-3 border mb-2 d-flex justify-content-around text-center">
                <div>
                    <small class="text-muted d-block">@Names.GetName((ServicingDto x) => x.RegistrationNumber)</small>
                    <strong class="text-primary">@editingServicing.RegistrationNumber</strong>
                </div>
                <div>
                    <small class="text-muted d-block">@Names.GetName((ServicingDto x) => x.Vin)</small>
                    <strong class="text-secondary">@editingServicing.Vin</strong>
                </div>
            </div>

            <div class="col-md-4">
                <label class="form-label font-weight-bold">@Names.GetName((ServicingDto x) => x.ServiceNumber)</label>
                <InputText class="form-control" @bind-Value="editingServicing.ServiceNumber" />
            </div>
            <div class="col-md-4"> 
                <label class="form-label font-weight-bold">@Names.GetName((ServicingDto x) => x.VehicleId)</label>
                <InputSelect class="form-select" @bind-Value="editingServicing.VehicleId">
                    <option value="0" disabled>-- Wybierz pojazd --</option>
                    @if (availableVehicles != null)
                    {
                        @foreach (var v in availableVehicles)
                        {
                            <option value="@v.Id">@v.RegistrationNumber</option>
                        }
                    }
                </InputSelect>
            </div>
            <div class="col-md-4">
                <label class="form-label font-weight-bold">@Names.GetName((ServicingDto x) => x.ClerkUsername)</label>
                <InputText class="form-control" @bind-Value="editingServicing.ClerkUsername" disabled />
            </div>

            <div class="col-md-4">
                <label class="form-label font-weight-bold">@Names.GetName((ServicingDto x) => x.ServiceDate)</label>
                <InputDate class="form-control" @bind-Value="editingServicing.ServiceDate" />
            </div>
            <div class="col-md-8">
                <label class="form-label font-weight-bold">@Names.GetName((ServicingDto x) => x.MechanicName)</label>
                <InputText class="form-control" @bind-Value="editingServicing.MechanicName" />
            </div>

            <div class="col-md-12">
                <label class="form-label font-weight-bold">@Names.GetName((ServicingDto x) => x.Cost)</label>
                <InputNumber class="form-control" @bind-Value="editingServicing.Cost" />
            </div>
            <div class="col-md-12">
                <label class="form-label font-weight-bold">@Names.GetName((ServicingDto x) => x.IssueDescription)</label>
                <InputTextArea class="form-control" @bind-Value="editingServicing.IssueDescription" rows="4" />
            </div>

            <div class="col-12 text-end mt-4 pt-3 border-top">
                <button type="button" class="btn btn-secondary me-2" @onclick="() => showEditModal = false">Anuluj</button>
                <button type="submit" class="btn btn-primary"><i class="bi bi-save"></i> Zapisz zmiany</button>
            </div>
        </div>
    </EditForm>
</EditModal>


@code {
    private ServicingDto[]? servicings;
    
    private VehicleDto[]? availableVehicles;
    
    private string currentUserName = "";
    private ServicingDto newServicing = new() { ServiceDate = DateOnly.FromDateTime(DateTime.Now) };
    private ServicingDto editingServicing = new();
    private ServicingDto? selectedServicing;

    private bool showEditModal = false;
    private bool showDetailsModal = false;
    
    private string? addErrorMessage;
    private string? editErrorMessage;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var userData = await Http.GetFromJsonAsync<UserDto>("user/login_details");
            if (userData == null || (int)userData.RoleLevel < 2)
            {
                Nav.NavigateTo("/home");
                return;
            }
            await LoadCurrentUser();
            await LoadVehicles();
            await LoadServicings();
        }
        catch
        {
            Nav.NavigateTo("/");
        }
    }

    private async Task LoadCurrentUser()
    {
        try
        {
            var userData = await Http.GetFromJsonAsync<UserDto>("user/login_details");
            
            if (userData != null && !string.IsNullOrEmpty(userData.Username))
            {
                currentUserName = userData.Username;
                newServicing.ClerkUsername = currentUserName; 
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Couldn't load user info: {ex.Message}");
        }
    }
    
    private async Task LoadVehicles()
    {
        try
        {
            availableVehicles = await Http.GetFromJsonAsync<VehicleDto[]>("/api/vehicles/get_all");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading vehicles: {ex.Message}");
        }
    }
    
    private async Task LoadServicings()
    {
        servicings = await Http.GetFromJsonAsync<ServicingDto[]>("/api/service/get_all");
    }
    
    private async Task ShowDetails(ServicingDto service)
    {
        showDetailsModal = true;
        selectedServicing = null; 
        
        var requestBody = new { Id = service.Id };
        var response = await Http.PostAsJsonAsync("/api/service/get_detail", requestBody);
        if (response.IsSuccessStatusCode)
        {
            selectedServicing = await response.Content.ReadFromJsonAsync<ServicingDto>();
        }
    }

    private async Task AddServicing()
    {
        addErrorMessage = Validation.Check(newServicing, skipIdFields: true);
        if (addErrorMessage != null) return;
        
        var response = await Http.PostAsJsonAsync("/api/service/add", newServicing);
        if (response.IsSuccessStatusCode)
        {
            addErrorMessage = null;
            newServicing = new ServicingDto()
            {
                ServiceDate = DateOnly.FromDateTime(DateTime.Now),
                ClerkUsername = currentUserName
            };
            await LoadServicings();
        }
        else
        {
            addErrorMessage = (await response.Content.ReadAsStringAsync()).Trim('"');
        }
    }

    private async Task DeleteServicing(ServicingDto service)
    {
        var requestBody = new { Id = service.Id };
        
        var response = await Http.PostAsJsonAsync($"/api/service/delete", requestBody);
        if (response.IsSuccessStatusCode)
        {
            await LoadServicings();
        }
        else
        {
            Console.WriteLine($"Error deleting a service: {response.StatusCode}");
        }
    }

    private void OpenEditModal(ServicingDto service)
    {
        editingServicing = new ServicingDto
        {
            Id = service.Id,
            ServiceNumber = service.ServiceNumber,
            VehicleId = service.VehicleId,
            ClerkUsername = service.ClerkUsername,
            IssueDescription = service.IssueDescription,
            ServiceDate = service.ServiceDate,
            MechanicName = service.MechanicName,
            Cost = service.Cost,
            Vin = service.Vin,
            RegistrationNumber = service.RegistrationNumber
        };
        showEditModal = true;
    }
    
    private async Task SaveEdit()
    {
        editErrorMessage = Validation.Check(editingServicing);
        if (editErrorMessage != null) return;
        
        var response = await Http.PostAsJsonAsync("/api/service/edit", editingServicing);
        if (response.IsSuccessStatusCode)
        {
            editErrorMessage = null;
            showEditModal = false;
            await LoadServicings();
        }
        else
        {
            editErrorMessage = (await response.Content.ReadAsStringAsync()).Trim('"');
        }
    }
}