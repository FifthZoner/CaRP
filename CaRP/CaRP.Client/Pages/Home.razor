@page "/home"
@using System.Net
@using System.Net.Http
@using System.Net.Http.Json
@using System.Threading.Tasks
@using CaRP.Shared.Dtos
@rendermode InteractiveWebAssembly
@inject IJSRuntime JSRuntime
@inject HttpClient Http

<PageTitle>Home</PageTitle>

<h1 class="text-center">Welcome to CaRP</h1>

<h1 class="text-center">API Data</h1>

@if (apiResponse == null)
{
    <p><em>Loading...</em></p>
}
else
{
    <p>Response from API: @apiResponse</p>
}

<button class="btn btn-secondary" @onclick="CallApi">Fetch Secure Data</button>

@code {
    // ładowanie danych
    private string? apiResponse;

    private async Task CallApi()
    {
        try
        {
            var result = await Http.GetFromJsonAsync<LoginInfoDto>("user/login_details");
            apiResponse = $"Name: {result?.Username}, ImageUrl: {result?.ImageUrl}, RoleLevel: {result?.RoleLevel}";
        }
        catch (HttpRequestException ex)
        {
            // This will catch 401 Unauthorized if the token is missing or invalid
            Console.WriteLine($"Request failed: {ex.Message}");
            apiResponse = "Unauthorized or Server Error";
        }
    }


}