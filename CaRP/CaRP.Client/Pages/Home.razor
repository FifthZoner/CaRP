@page "/home"
@using CaRP.Shared.Dtos
@using carp.Shared.Enums
@rendermode InteractiveWebAssembly
@inject HttpClient Http
@inject NavigationManager Nav

<PageTitle>Panel Użytkownika - CaRP</PageTitle>

<div class="container mt-5">
    @if (userData == null)
    {
        <div class="text-center">
            <div class="spinner-border text-primary" role="status"></div>
            <p class="mt-3 text-muted">Ładowanie Twojego profilu...</p>
        </div>
    }
    else
    {
        <div class="row justify-content-center">
            <div class="col-md-8">
                <div class="card shadow-sm border-0 rounded-4 overflow-hidden">
                    <div class="card-header bg-primary text-white py-4 text-center">
                        <h2 class="mb-0">Witaj, @userData.Username!</h2>
                    </div>
                    <div class="card-body p-5 text-center">
                        <div class="mb-4">
                            <i class="bi bi-person-badge text-primary" style="font-size: 3rem;"></i>
                        </div>
                        
                        <h4 class="mb-4">Informacje o profilu</h4>
                        <div class="list-group list-group-flush mb-5">
                            <div class="list-group-item d-flex justify-content-between align-items-center px-0">
                                <span class="text-muted">Twoja rola:</span>
                                <span class="badge bg-info text-dark rounded-pill fs-6 px-3">@userData.RoleLevel</span>
                            </div>
                        </div>

                        <div class="d-grid gap-3 mt-4">
                            <a href="/WorkRegistrations" class="btn btn-success btn-lg shadow-sm">
                                <i class="bi bi-clipboard-data me-2"></i> Przejdź do Kart Pracy
                            </a>
                            
                            @if ((int)userData.RoleLevel >= 2)
                            {
                                <a href="/vehicles" class="btn btn-outline-secondary">
                                    <i class="bi bi-truck me-2"></i> Przeglądaj pojazdy
                                </a>
                            }
                            
                            @if ((int)userData.RoleLevel == 3)
                            {
                                <a href="/users" class="btn btn-outline-secondary">
                                    <i class="bi bi-truck me-2"></i> Przeglądaj użytkowników
                                </a>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

@code {
    private LoginInfoDto? userData;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            userData = await Http.GetFromJsonAsync<LoginInfoDto>("user/login_details");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading user profile: {ex.Message}");
        }
    }
}