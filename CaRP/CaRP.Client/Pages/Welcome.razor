@page "/"
@using CaRP.Shared.Dtos
@rendermode InteractiveWebAssembly
@inject IJSRuntime JSRuntime
@inject HttpClient Http
@inject NavigationManager Nav

<PageTitle>Witaj w CaRP</PageTitle>

<div class="container text-center mt-5">
    <h1 class="display-3 fw-bold text-primary mb-2">Witaj w CaRP!</h1>
    <p class="lead text-muted mb-5">System zarządzania twoją flotą pojazdów</p>

    @* TODO: logo image in here
    
    <div class="logo-container my-5 py-4">
        <div class="mx-auto shadow-sm d-flex align-items-center justify-content-center" 
             style="width: 250px; height: 250px; background-color: #f8f9fa; border-radius: 50%; border: 2px dashed #dee2e6;">
            <i class="bi bi-car-front text-secondary" style="font-size: 100px;"></i>
            </div>
    </div>
    *@

    @if (isLoading)
    {
        <div class="spinner-border text-primary" role="status"></div>
    }
    else if (isLoggedIn)
    {
        <div class="d-grid gap-3 mt-5">
            <a href="/home" class="btn btn-primary btn-lg px-5 shadow">
                <i class="bi bi-house-door me-2"></i> Przejdź do panelu użytkownika
            </a>
            <button class="btn btn-outline-danger btn-lg px-4" @onclick="HandleLogout">
                <i class="bi bi-box-arrow-right me-2"></i> Wyloguj się
            </button>
        </div>
    }
    else 
    {
        <div class="d-flex flex-column align-items-center gap-3 mt-4">
            <button class="btn btn-primary btn-lg px-5 shadow" @onclick="HandleLogin">
                <i class="bi bi-box-arrow-in-right me-2"></i> Zaloguj się
            </button>
            <button class="btn btn-outline-primary btn-lg px-5" @onclick="HandleSignUp">
                <i class="bi bi-person-plus me-2"></i> Zarejestruj się
            </button>
        </div>
    }
</div>

@code {
    private bool isLoading = true;
    private bool isLoggedIn = false;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await JSRuntime.InvokeVoidAsync("clerkInterop.init");
            await CheckAuthState();
            isLoading = false;
            StateHasChanged();
        }
    }

    private async Task CheckAuthState()
    {
        try
        {
            var token = await JSRuntime.InvokeAsync<string>("clerkInterop.getAccessToken");
            isLoggedIn = !string.IsNullOrEmpty(token);
        }
        catch { isLoggedIn = false; }
    }

    private async Task HandleLogin() => await JSRuntime.InvokeVoidAsync("clerkInterop.openSignIn");

    private async Task HandleSignUp()
    {
        try
        {
            await JSRuntime.InvokeVoidAsync("clerkInterop.openSignUp");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Sign up error: {ex.Message}");
        }
    } 
    
    private async Task HandleLogout()
    {
        try
        {
            await JSRuntime.InvokeVoidAsync("clerkInterop.logout");
            Nav.NavigateTo("/", forceLoad: true);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error while logging out: {ex.Message}");
        }
    }
}