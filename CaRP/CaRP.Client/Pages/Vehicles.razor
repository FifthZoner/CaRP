@page "/vehicles"
@using CaRP.Shared.Dtos
@using CaRP.Client.Components
@inject HttpClient Http
@rendermode @(new InteractiveWebAssemblyRenderMode(prerender: false))

<PageTitle>Pojazdy</PageTitle>

<h1>Lista pojazdów</h1>

<PageTemplate TItem="VehicleDto" Items="vehicles" Context="vehicle">
    
    <FormTemplate>
        <div class="alert alert-info">
            Tutaj będzie formularz dodawania pojazdu
        </div>
    </FormTemplate>

    <TableHeader>
        <th>ID</th>
        <th>VIN</th>
        <th>Nr Rejestracyjny</th>
        <th>Typ pojazdu</th>
        <th>Dostępny od</th>
        <th>Dostępny do</th>
        <th>Firmowy?</th>
    </TableHeader>

    <TableRow>
        <td>@vehicle.Id</td>
        <td>@vehicle.Vin</td>
        <td><strong>@vehicle.RegistrationNumber</strong></td>
        <td>@vehicle.VehicleType</td>
                
        <td>@(vehicle.AvailableFrom?.ToString("dd.MM.yyyy") ?? "-")</td>
        <td>@(vehicle.AvailableTo?.ToString("dd.MM.yyyy") ?? "-")</td>
                
        <td>
            @if (vehicle.IsOwnedByCompany)
            {
                <span class="badge bg-success">Tak</span>
            }
            else
            {
                <span class="badge bg-secondary">Nie</span>
            }
        </td>
    </TableRow>

</PageTemplate>

@code {
    private VehicleDto[]? vehicles;
    
    protected override async Task OnInitializedAsync()
    {
        vehicles = await Http.GetFromJsonAsync<VehicleDto[]>("/api/vehicles/get_all");
    }
}