<BaseModal IsVisible="IsVisible"
           Title="@Title"
           HeaderColorClass="bg-danger"
           ModalSizeClass="" 
           OnClose="Cancel">
    
    <ChildContent>
        <p>@Message</p>
    </ChildContent>
    
    <FooterContent>
        <button type="button" class="btn btn-secondary" @onclick="Cancel">Anuluj</button>
        <button type="button" class="btn btn-danger" @onclick="Confirm">Potwierdź</button>
    </FooterContent>

</BaseModal>

@code {
    [Parameter] public bool IsVisible { get; set; }
    [Parameter] public string Title { get; set; } = "Potwierdzenie";
    [Parameter] public string Message { get; set; } = "Czy jesteś pewny?";
    [Parameter] public EventCallback OnConfirm { get; set; }
    [Parameter] public EventCallback OnCancel { get; set; }

    private Task Cancel() => OnCancel.InvokeAsync();
    private Task Confirm() => OnConfirm.InvokeAsync();
}