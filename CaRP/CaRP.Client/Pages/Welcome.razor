@page "/"
@using System.Net
@using System.Net.Http
@using System.Net.Http.Json
@using System.Threading.Tasks
@using CaRP.Shared.Dtos
@rendermode InteractiveWebAssembly
@inject IJSRuntime JSRuntime
@inject HttpClient Http

<PageTitle>CaRP</PageTitle>

<h1>Witaj w CaRP!</h1>
<h3>To system który poprowadzi twoją flotę do zwycięstwa!</h3>
<p>Zaloguj się pls</p>

<button class="btn btn-primary" @onclick="HandleLogin">
    Login with Clerk
</button>


@code {
    private string? _accessToken;

    private async Task GetToken()
    {
        try
        {
            _accessToken = await JSRuntime.InvokeAsync<string>("clerkInterop.getAccessToken");
            Console.WriteLine("Token retrieved!");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error fetching token: {ex.Message}");
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            // Ensure Clerk is loaded before we try to use it
            await JSRuntime.InvokeVoidAsync("clerkInterop.init");
        }
    }

    private async Task HandleLogin()
    {
        try
        {
            await JSRuntime.InvokeVoidAsync("clerkInterop.openSignIn");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Auth Error: {ex.Message}");
        }
    }
}