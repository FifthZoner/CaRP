@page "/"
@using System.Net.Http.Json
@using CaRP.Shared.Dtos
@using carp.Shared.Enums
@rendermode InteractiveWebAssembly
@inject IJSRuntime JSRuntime
@inject HttpClient Http

<PageTitle>CaRP</PageTitle>

@if (isLoading)
{
    <div class="text-center mt-5">
        <div class="spinner-border text-primary" role="status"></div>
        <p class="mt-2">Sprawdzanie statusu logowania...</p>
    </div>
}
else if (isLoggedIn)
{
    <div class="text-center mt-5">
        <h1 class="display-4 fw-bold">Witaj w CaRP, @userName!</h1>
        <h3 class="text-muted mt-3">CaRP to system, który poprowadzi Twoją flotę do zwycięstwa!</h3>
        <h4 class="text-muted mt-3">Twoja rola to: @role</h4>
        
        <div class="mt-5">
            <a href="/WorkRegistrations" class="btn btn-success btn-lg px-5">
                <i class="bi bi-car-front-fill me-2"></i> Karty pracy
            </a>
        </div>
        <div class="mt-5">
            <button class="btn btn-outline-danger btn-lg px-4" @onclick="HandleLogout">
                <i class="bi bi-box-arrow-right me-2"></i> Wyloguj się
            </button>
        </div>
    </div>
}
else
{
    <div class="text-center mt-5">
        <h1 class="display-4 fw-bold">Witaj w CaRP!</h1>
        <h3 class="text-muted mt-3">CaRP to system, który poprowadzi Twoją flotę do zwycięstwa!</h3>
        <p class="lead mt-4">Zaloguj się lub utwórz konto.</p>

        <div class="d-flex justify-content-center gap-3 mt-4">
            <button class="btn btn-primary btn-lg px-4" @onclick="HandleLogin">
                <i class="bi bi-box-arrow-in-right me-2"></i> Zaloguj się
            </button>
            <button class="btn btn-outline-primary btn-lg px-4" @onclick="HandleSignUp">
                <i class="bi bi-person-plus me-2"></i> Zarejestruj się
            </button>
        </div>
    </div>
}

@code {
    private bool isLoading = true;
    private bool isLoggedIn = false;
    private string userName = "";
    private RoleEnum role;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await JSRuntime.InvokeVoidAsync("clerkInterop.init");
            
            await CheckAuthState();
            
            isLoading = false;
            StateHasChanged();
        }
    }
    private async Task CheckAuthState()
    {
        try
        {
            var token = await JSRuntime.InvokeAsync<string>("clerkInterop.getAccessToken");
            
            if (!string.IsNullOrEmpty(token))
            {
                isLoggedIn = true;
                
                var userData = await Http.GetFromJsonAsync<LoginInfoDto>("user/login_details");
                userName = userData?.Username;
                role = userData.RoleLevel;
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Auth error: {ex.Message}");
        }
    }

    private async Task HandleLogin()
    {
        try
        {
            await JSRuntime.InvokeVoidAsync("clerkInterop.openSignIn");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Auth Error (Login): {ex.Message}");
        }
    }

    private async Task HandleSignUp()
    {
        try
        {
            //
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Auth Error (SignUp): {ex.Message}");
        }
    }
    
    private async Task HandleLogout()
    {
        try
        {
            // isLoggedIn = false;
            // userName = "";
            // StateHasChanged();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Auth Error (Logout): {ex.Message}");
        }
    }
}