@page "/"
@using System.Net
@using System.Net.Http
@using System.Net.Http.Json
@using System.Threading.Tasks
@rendermode InteractiveWebAssembly
@inject IJSRuntime JSRuntime
@inject HttpClient Http

<PageTitle>Home</PageTitle>

<h1>Welcome to CaRP</h1>

<button class="btn btn-primary" @onclick="HandleLogin">
    Login with Clerk
</button>

@code {
    private string? _accessToken;

    private async Task GetToken()
    {
        try
        {
            _accessToken = await JSRuntime.InvokeAsync<string>("clerkInterop.getAccessToken");
            Console.WriteLine("Token retrieved!");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error fetching token: {ex.Message}");
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            // Ensure Clerk is loaded before we try to use it
            await JSRuntime.InvokeVoidAsync("clerkInterop.init");
        }
    }

    private async Task HandleLogin()
    {
        try
        {
            await JSRuntime.InvokeVoidAsync("clerkInterop.openSignIn");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Auth Error: {ex.Message}");
        }
    }
}





<h1>API Data</h1>

@if (apiResponse == null)
{
    <p><em>Loading...</em></p>
}
else
{
    <p>Response from API: @apiResponse</p>
}

<button class="btn btn-secondary" @onclick="CallApi">Fetch Secure Data</button>

@code {
    // ładowanie danych
    private string? apiResponse;

    private async Task CallApi()
    {
        try
        {
            var result = await Http.GetFromJsonAsync<MyDataModel>("api/user/check_login");
            apiResponse = result?.Name;
        }
        catch (HttpRequestException ex)
        {
            // This will catch 401 Unauthorized if the token is missing or invalid
            Console.WriteLine($"Request failed: {ex.Message}");
            apiResponse = "Unauthorized or Server Error";
        }
    }

    public class MyDataModel { public string Name { get; set; } }
}