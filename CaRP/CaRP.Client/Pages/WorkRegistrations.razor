@page "/WorkRegistrations"
@using System.Globalization
@using CaRP.Shared.Dtos
@using CaRP.Client.Components
@inject HttpClient Http
@rendermode @(new InteractiveWebAssemblyRenderMode(prerender: false))

<PageTitle>Karty pracy</PageTitle>

<h1>Karty pracy</h1>

<PageTemplate TItem="WorkRegistrationDto" Items="works" Context="work">

    <FormTemplate>
        <div class="alert alert-info">
            Tutaj będzie formularz dodawania kart pracy
        </div>
    </FormTemplate>

    <TableHeader>
        <th>ID</th>
        <th>Nr Rejestracyjny</th>
        <th>Użytkownik</th>
        <th>Data</th>
        <th>Godziny pracy</th>
        <th>Koszt</th>
    </TableHeader>

    <TableRow>
        <td>@work.Id</td>
        <td><strong>@work.RegistrationNumber</strong></td>
        <td>@work.ClerkUsername</td>

        <td>@(work.WorkDate.ToString("dd.MM.yyyy"))</td>
        <td>@work.DurationHours.ToString("N2")</td>
        <td>@((work.DurationHours * work.CostPerHour).ToString("N2") + " PLN")</td>
    </TableRow>

</PageTemplate>

@code {
    private WorkRegistrationDto[]? works;

    protected override async Task OnInitializedAsync()
    {
        works = await Http.GetFromJsonAsync<WorkRegistrationDto[]>("/api/work/get_all");
    }
}