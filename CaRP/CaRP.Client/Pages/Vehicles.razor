@page "/vehicles"
@using CaRP.Shared.Dtos
@using CaRP.Client.Components
@using carp.Shared.Utils
@inject HttpClient Http
@inject NavigationManager Nav
@rendermode @(new InteractiveWebAssemblyRenderMode(prerender: false))

<PageTitle>Pojazdy</PageTitle>

<h1 class="text-center">Lista pojazdów</h1>

<PageTemplate TItem="VehicleDto" 
              Items="vehicles" 
              NewItem="newVehicle" 
              OnSave="AddVehicle" 
              OnDetails="ShowDetails"
              OnEdit="OpenEditModal"
              OnDelete="DeleteVehicle"
              FormTitle="Dodaj nowy pojazd"
              Context="vehicle">
    
    <FormFields>
        @if (!string.IsNullOrEmpty(addErrorMessage))
        {
            <div class="col-12 mb-3">
                <div class="alert alert-danger">
                    <i class="bi bi-exclamation-triangle-fill me-2"></i> @addErrorMessage
                </div>
            </div>
        }

        <div class="col-md-3">
            <label class="form-label font-weight-bold">@Names.GetName((VehicleDto x) => x.Vin)</label>
            <InputText class="form-control" @bind-Value="newVehicle.Vin" />
        </div>
        <div class="col-md-3">
            <label class="form-label font-weight-bold">@Names.GetName((VehicleDto x) => x.RegistrationNumber)</label>
            <InputText class="form-control" @bind-Value="newVehicle.RegistrationNumber" />
        </div>
        <div class="col-md-3">
            <label class="form-label font-weight-bold">@Names.GetName((VehicleDto x) => x.VehicleType)</label>
            <InputText class="form-control" @bind-Value="newVehicle.VehicleType" />
        </div>
        <div class="col-md-3 d-flex align-items-end">
            <div class="form-check mb-2">
                <InputCheckbox class="form-check-input" id="isCompany" @bind-Value="newVehicle.IsOwnedByCompany" />
                <label class="form-check-label font-weight-bold" for="isCompany">@Names.GetName((VehicleDto x) => x.IsOwnedByCompany)</label>
            </div>
        </div>
        <div class="col-md-3">
            <label class="form-label font-weight-bold">@Names.GetName((VehicleDto x) => x.AvailableFrom)</label>
            <InputDate class="form-control" @bind-Value="newVehicle.AvailableFrom" />
        </div>
        <div class="col-md-3">
            <label class="form-label font-weight-bold">@Names.GetName((VehicleDto x) => x.AvailableTo)</label>
            <InputDate class="form-control" @bind-Value="newVehicle.AvailableTo" />
        </div>
    </FormFields>
    
    
    <TableHeader>
        <th>@Names.GetName((VehicleDto x) => x.Vin)</th>
        <th>@Names.GetName((VehicleDto x) => x.RegistrationNumber)</th>
        <th>@Names.GetName((VehicleDto x) => x.VehicleType)</th>
        <th>@Names.GetName((VehicleDto x) => x.AvailableFrom)</th>
        <th>@Names.GetName((VehicleDto x) => x.AvailableTo)</th>
        <th>@Names.GetName((VehicleDto x) => x.IsOwnedByCompany)</th>
    </TableHeader>

    <TableRow>
        <td>@vehicle.Vin</td>
        <td><strong>@vehicle.RegistrationNumber</strong></td>
        <td>@vehicle.VehicleType</td>
                
        <td>@(vehicle.AvailableFrom?.ToString("dd.MM.yyyy") ?? "-")</td>
        <td>@(vehicle.AvailableTo?.ToString("dd.MM.yyyy") ?? "-")</td>
                
        <td>
            @if (vehicle.IsOwnedByCompany)
            {
                <span class="badge bg-success">Tak</span>
            }
            else
            {
                <span class="badge bg-secondary">Nie</span>
            }
        </td>
    </TableRow>

</PageTemplate>


<DetailsModal IsVisible="@showDetailsModal" Title="Szczegóły Pojazdu" OnClose="() => showDetailsModal = false">
    @if (selectedVehicle == null)
    {
        <div class="text-center">
            <div class="spinner-border text-info" role="status"></div>
            <p>Pobieranie danych...</p>
        </div>
    }
    else
    {
        <div class="row">
            <div class="col-md-6">
                <p><strong>@Names.GetName((VehicleDto x) => x.Id):</strong> @selectedVehicle.Id</p>
                <p><strong>@Names.GetName((VehicleDto x) => x.RegistrationNumber):</strong> @selectedVehicle.RegistrationNumber</p>
                <p><strong>@Names.GetName((VehicleDto x) => x.Vin):</strong> @selectedVehicle.Vin</p>
                <p><strong>@Names.GetName((VehicleDto x) => x.VehicleType):</strong> @selectedVehicle.VehicleType</p>
            </div>
            <div class="col-md-6">
                <p><strong>@Names.GetName((VehicleDto x) => x.IsOwnedByCompany):</strong> @(selectedVehicle.IsOwnedByCompany ? "Tak" : "Nie")</p>
                <p><strong>@Names.GetName((VehicleDto x) => x.AvailableFrom):</strong> @(selectedVehicle.AvailableFrom?.ToString("dd.MM.yyyy") ?? "Brak")</p>
                <p><strong>@Names.GetName((VehicleDto x) => x.AvailableTo):</strong> @(selectedVehicle.AvailableTo?.ToString("dd.MM.yyyy") ?? "Brak")</p>
            </div>
        </div>
    }
</DetailsModal>


<EditModal IsVisible="@showEditModal" 
           Title="@($"Edytuj pojazd: {editingVehicle.RegistrationNumber}")" 
           OnClose="() => showEditModal = false">
    
    <EditForm Model="editingVehicle" OnValidSubmit="SaveEdit">
        
        @if (!string.IsNullOrEmpty(editErrorMessage))
        {
            <div class="alert alert-danger mb-3">
                <i class="bi bi-exclamation-triangle-fill me-2"></i> @editErrorMessage
            </div>
        }

        <div class="row g-3">
            <div class="col-md-6">
                <label class="form-label font-weight-bold">@Names.GetName((VehicleDto x) => x.Vin)</label>
                <InputText class="form-control" @bind-Value="editingVehicle.Vin" />
            </div>
            <div class="col-md-6">
                <label class="form-label font-weight-bold">@Names.GetName((VehicleDto x) => x.RegistrationNumber)</label>
                <InputText class="form-control" @bind-Value="editingVehicle.RegistrationNumber" />
            </div>
            <div class="col-md-6">
                <label class="form-label font-weight-bold">@Names.GetName((VehicleDto x) => x.VehicleType)</label>
                <InputText class="form-control" @bind-Value="editingVehicle.VehicleType" />
            </div>
            <div class="col-md-6 d-flex align-items-end">
                <div class="form-check mb-2">
                    <InputCheckbox class="form-check-input" id="editIsCompany" @bind-Value="editingVehicle.IsOwnedByCompany" />
                    <label class="form-check-label font-weight-bold" for="editIsCompany">@Names.GetName((VehicleDto x) => x.IsOwnedByCompany)</label>
                </div>
            </div>
            <div class="col-md-6">
                <label class="form-label font-weight-bold">@Names.GetName((VehicleDto x) => x.AvailableFrom)</label>
                <InputDate class="form-control" @bind-Value="editingVehicle.AvailableFrom" />
            </div>
            <div class="col-md-6">
                <label class="form-label font-weight-bold">@Names.GetName((VehicleDto x) => x.AvailableTo)</label>
                <InputDate class="form-control" @bind-Value="editingVehicle.AvailableTo" />
            </div>

            <div class="col-12 text-end mt-4 pt-3 border-top">
                <button type="button" class="btn btn-secondary me-2" @onclick="() => showEditModal = false">
                    Anuluj
                </button>
                <button type="submit" class="btn btn-primary">
                    <i class="bi bi-save"></i> Zapisz zmiany
                </button>
            </div>
        </div>
    </EditForm>
</EditModal>


@code {
    private VehicleDto[]? vehicles;
    private VehicleDto newVehicle = new();
    
    private bool showDetailsModal = false;
    private VehicleDto? selectedVehicle = null;
    private bool showEditModal = false;
    private VehicleDto editingVehicle = new();
    
    private string? addErrorMessage;
    private string? editErrorMessage;
    
    protected override async Task OnInitializedAsync()
    {
        try
        {
            var userData = await Http.GetFromJsonAsync<UserDto>("user/login_details");
            if (userData == null || (int)userData.RoleLevel < 2)
            {
                Nav.NavigateTo("/home");
                return;
            }

            await LoadVehicles();
        }
        catch
        {
            Nav.NavigateTo("/");
        }
    }
    
    private async Task LoadVehicles()
    {
        vehicles = await Http.GetFromJsonAsync<VehicleDto[]>("/api/vehicles/get_all");
    }
    
    private async Task ShowDetails(VehicleDto vehicle)
    {
        selectedVehicle = null;
        showDetailsModal = true;
        
        var requestBody = new { Id = vehicle.Id };
        var response = await Http.PostAsJsonAsync("/api/vehicles/get_detail", requestBody);
        if (response.IsSuccessStatusCode)
        {
            selectedVehicle = await response.Content.ReadFromJsonAsync<VehicleDto>();
        }
    }
    
    private async Task<bool> AddVehicle()
    {
        addErrorMessage = Validation.Check(newVehicle, skipIdFields: true);
        if (addErrorMessage != null) 
        {
            StateHasChanged();
            return false;
        }

        var response = await Http.PostAsJsonAsync("/api/vehicles/add", newVehicle);
        if (response.IsSuccessStatusCode)
        {
            addErrorMessage = null;
            newVehicle = new VehicleDto();
            await LoadVehicles();
            return true;
        }
        else
        {
            addErrorMessage = (await response.Content.ReadAsStringAsync()).Trim('"');
            StateHasChanged();
            return false;
        }
    }
    
    private void OpenEditModal(VehicleDto vehicle)
    {
        editingVehicle = new VehicleDto 
        {
            Id = vehicle.Id,
            Vin = vehicle.Vin,
            RegistrationNumber = vehicle.RegistrationNumber,
            AvailableFrom = vehicle.AvailableFrom,
            AvailableTo = vehicle.AvailableTo,
            IsOwnedByCompany = vehicle.IsOwnedByCompany,
            VehicleType = vehicle.VehicleType
        };
        showEditModal = true;
    }
    
    private async Task SaveEdit()
    {
        editErrorMessage = Validation.Check(editingVehicle);
        if (editErrorMessage != null) return;

        var response = await Http.PostAsJsonAsync("/api/vehicles/edit", editingVehicle);
        if (response.IsSuccessStatusCode)
        {
            editErrorMessage = null;
            showEditModal = false;
            await LoadVehicles();
        }
        else
        {
            editErrorMessage = (await response.Content.ReadAsStringAsync()).Trim('"');
        }
    }
    
    private async Task DeleteVehicle(VehicleDto vehicle)
    {
        var requestBody = new { Id = vehicle.Id };
        
        var response = await Http.PostAsJsonAsync("/api/vehicles/delete", requestBody);

        if (response.IsSuccessStatusCode)
        {
            await LoadVehicles(); 
        }
        else
        {
            Console.WriteLine($"Error deleting vehicle: {response.StatusCode}");
        }
    }
}